name: Flutter Build & Auto Sync

on:
  push:
    branches:
      - main      # Bổ sung main để trigger job tự động merge
      - staging
      - prod

# Bắt buộc phải có quyền ghi để GitHub Actions có thể tự động push code
permissions:
  contents: write

jobs:
  # ---------------------------------------------------------
  # JOB 1: CHỈ BUILD TRÊN STAGING VÀ PROD
  # ---------------------------------------------------------
  build:
    if: github.ref_name == 'staging' || github.ref_name == 'prod'
    runs-on: ubuntu-latest

    steps:
      # 1. Checkout code
      - uses: actions/checkout@v4

      # 2. Setup Java 17
      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      # 3. Setup Flutter
      - name: Set up Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: 'stable'

      # 4. Install dependencies
      - name: Install dependencies
        run: flutter pub get

      # 5. Build theo nhánh
      - name: Build APK/AppBundle
        run: |
          if [[ "${{ github.ref_name }}" == "staging" ]]; then
            echo "Building Beta version for Staging..."
            flutter build apk --debug --flavor staging # Hoặc --profile tùy bạn
          else
            echo "Building Release version for Production..."
            flutter build apk --release
          fi

      # 6. Xóa Artifact cũ (Chuyển lên trước khi upload để không xóa nhầm bản mới)
      - name: Delete old artifacts
        uses: geekyeggo/delete-artifact@v5
        with:
          name: flutter-app-${{ github.ref_name }}
          use_glob: false
          failOnError: false

      # 7. Upload Artifact
      - name: Upload Build Artifact
        uses: actions/upload-artifact@v4
        with:
          name: flutter-app-${{ github.ref_name }}
          path: build/app/outputs/flutter-apk/*.apk
          retention-days: 7 # Giữ lại trong 7 ngày

  # ---------------------------------------------------------
  # JOB 2: TỰ ĐỘNG MERGE TỪ MAIN SANG STAGING
  # ---------------------------------------------------------
  sync_main_to_staging:
    if: github.ref_name == 'main'
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0 # Bắt buộc phải fetch toàn bộ history để merge không bị lỗi

      - name: Auto Merge main into staging
        run: |
          # Cấu hình danh tính cho Bot
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          
          # Checkout sang nhánh staging
          git checkout staging
          
          # Pull update mới nhất của staging để tránh conflict ngầm
          git pull origin staging
          
          # Merge code từ nhánh main sang staging (giữ nguyên commit message)
          git merge origin/main --no-edit
          
          # Push code đã merge lên nhánh staging
          git push origin staging